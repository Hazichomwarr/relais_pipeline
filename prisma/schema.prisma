// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RelaisProduct {
  KARMDA
  LOKARI
  NIA
  DIGITAL_SERVICES
}

// Ticket 20A — prospect receptiveness: "how open is this prospect to
// RELAIS," independent of commercial progression. Set at creation and on
// every follow-up/interaction update; never derived from `status`, and
// `status` is never derived from it. See the domain map above `model
// Prospect` for the full picture.
enum InterestLevel {
  NOT_INTERESTED
  MAYBE
  NEEDS_INFORMATION
  INTERESTED
  READY_TO_DISCUSS
}

enum FollowUpAction {
  CALL_BACK
  VISIT_AGAIN
  SEND_DEMO
  SCHEDULE_MEETING
  NO_ACTION
}

// Ticket 20A — the CRM's one commercial funnel/pipeline field ("where is
// this opportunity in the process"), already relied on as such by the
// Commercial dashboard's "Pipeline personnel" and its KPIs (qualified/
// won/lost counts, conversion rate). NEW → CONTACTED → QUALIFIED →
// PROPOSAL_SENT → WON/LOST is the intended forward progression; WON and
// LOST are terminal. No transition between values is enforced — any
// value may follow any other, including backward moves, because real
// sales conversations don't always move forward.
//
// TO_FOLLOW_UP is the one non-sequential exception: an operational
// "prioritize this in the queue" flag (see isFollowUpQueueCandidate),
// not a stage of commercial progress. Setting it overwrites whatever
// stage the prospect was actually at, which is a known, accepted
// limitation of the single-field design, not a stage that sits between
// NEW and CONTACTED. Do not reinterpret it as one.
//
// This is intentionally the CRM's only funnel-stage concept — do not add
// a parallel `stage` / `pipelineStage` / `commercialStage` field. See the
// domain map above `model Prospect`.
enum ProspectStatus {
  NEW
  TO_FOLLOW_UP
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum OnlinePresence {
  NONE
  WHATSAPP
  SOCIAL_MEDIA
  WEBSITE
  MULTIPLE
}

enum ProspectActivityType {
  FIELD_VISIT
  PHONE_CALL
  WHATSAPP
  MEETING
  DEMO
  DOCUMENT_SENT
  FOLLOW_UP
  INTERNAL_NOTE
  // System-generated only (Ticket 18A) — never user-selectable. Written in
  // the same transaction as the status mutation that causes the WON
  // transition, so À la une can source a reliable "prospect won" event
  // without fabricating history from Prospect.status alone.
  WON_TRANSITION
}

// Ticket 20D — the commercial effect of one follow-up interaction, not a
// current Prospect field: a prospect accumulates many outcomes over its
// life (see the conversionOutcome/conversionReason fields on
// ProspectActivity below). Distinct from Prospect.status (current funnel
// position) — a QUALIFIED prospect can legitimately have a STALLED
// follow-up, or an ADVANCED one without its status changing yet (Ticket
// 20A found no enforced transition state machine, and 20D does not add
// one). WON/LOST here must match Prospect.status exactly when set — see
// isConversionOutcomeConsistentWithStatus in
// prospect-conversion.service-core.ts.
enum ProspectConversionOutcome {
  ADVANCED
  STALLED
  WON
  LOST
}

// Ticket 20D — audited against real RELAIS ProspectActivity/Prospect.notes
// text (not invented) before being frozen; see
// prospect-conversion.service-core.ts for the outcome-compatibility
// matrix and prospect-conversion-options.ts for labels. PROMOTIONAL_OFFER
// names the commercial lever ("a promotion influenced the outcome"), not
// any specific campaign — the specific offer (École Pilote, a discount
// amount, a trial period, ...) belongs in conversionReasonNote / the
// follow-up note, never in a dedicated enum value, so this taxonomy
// survives campaigns coming and going. NEEDS_MORE_TIME and NO_URGENCY
// were merged after the audit: real notes never distinguished them.
enum ProspectConversionReason {
  // Advancement / WON
  PROMOTIONAL_OFFER
  DEMO_CONVINCED
  GOOD_PRODUCT_FIT
  URGENT_NEED
  PRICE_ACCEPTABLE
  DECISION_MAKER_APPROVAL

  // Stall / LOST
  NO_BUDGET
  PRICE_TOO_HIGH
  DECISION_MAKER_UNAVAILABLE
  ALREADY_EQUIPPED
  NO_RESPONSE
  NEEDS_MORE_TIME
  BAD_FIT
  COMPETITOR

  // Universal escape hatch — requires conversionReasonNote (Ticket 20D).
  OTHER
}

// Ticket 20B — deliberately small: OVERDUE is derived (status = OPEN and
// dueAt in the past), never persisted. No IN_PROGRESS/URGENT/BLOCKED
// either — add them only if real usage proves the lifecycle needs them.
enum ProspectActionStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum UserStatusActivityType {
  ACTIVATED
  DEACTIVATED
}

// Ticket 25M — ASSISTANT is a fourth authorization role (what this person
// may do in the CRM), unrelated to DailyReportTemplateType.ASSISTANT (a
// separate, independent enum naming a report-template kind, not an
// authorization tier — see that enum's own comment). The two enums
// legitimately share the string "ASSISTANT" for unrelated reasons.
enum UserRole {
  ADMIN
  ASSISTANT
  COMMERCIAL
  MANAGER
}

// Ticket 25I — DRAFT is editable by its evaluator; SUBMITTED is immutable.
// No further states in V1 (no void/supersede lifecycle yet — see the
// model comment above RoleResponsibilityAssessment).
enum RoleResponsibilityAssessmentStatus {
  DRAFT
  SUBMITTED
}

// Ticket 25I §11/§31 — explicit anchored choices, never a naked 1-5
// slider. The behavioral text for each level is responsibility-specific
// (src/lib/role-responsibility-catalog.ts), not a generic "poor/good/
// excellent" — this enum only names the four ordered levels themselves.
enum RoleResponsibilityAssessmentLevel {
  NOT_MET
  PARTIALLY_MET
  MET
  EXCEEDED
}

// Ticket 25I §7/§36 — every V1 catalog item is MANAGER_ASSESSED (see the
// catalog's own audit-verdict comment for why no machine-evidenced
// responsibility survived audit); the enum still names both values so a
// future genuinely machine-evidenced responsibility doesn't need a
// schema change to be added.
enum RoleResponsibilityEvidenceType {
  MANAGER_ASSESSED
  MACHINE_EVIDENCED
}

// Ticket 25J — same DRAFT/SUBMITTED shape as
// RoleResponsibilityAssessmentStatus, a separate enum rather than reused
// because Professional Contribution and Role Responsibilities are
// deliberately distinct domains (25J §28: "do not force unrelated
// semantics into the 25I model merely to reduce table count").
enum ProfessionalContributionAssessmentStatus {
  DRAFT
  SUBMITTED
}

enum PersonalNoteCategory {
  URGENT_TODO
  COMMERCIAL_DEBRIEF
  RELAIS_IDEA
  SCHOOL_DOCUMENTS
  OTHER
}

enum LedgerEntryType {
  INFLOW
  OUTFLOW
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHECK
  OTHER
}

// Ticket 25M — this ASSISTANT is a Daily Report template kind (which
// report form a user fills out), unrelated to UserRole.ASSISTANT (an
// authorization role). The two enums legitimately share this string for
// unrelated reasons; never infer one from the other.
enum DailyReportTemplateType {
  ASSISTANT
  OPERATIONS_COORDINATOR
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum LedgerEntryCategory {
  CLIENT_PAYMENT
  CAPITAL_CONTRIBUTION
  LOAN_RECEIVED
  REFUND_RECEIVED
  OTHER_INFLOW

  SALARY
  TRANSPORT
  FUEL
  PRINTING
  INTERNET
  OFFICE_SUPPLIES
  EQUIPMENT
  TAXES_AND_FEES
  CLIENT_REFUND
  OTHER_OUTFLOW
}

// Ticket 26B — the canonical tenant root. Deliberately minimal: no billing
// plan, subscription status, logo, address, settings JSON, ownerUserId, or
// Stripe IDs — those are later SaaS/product concerns, not foundation
// requirements. RELAIS is the one canonical row created by migration (see
// notes/ticket-26b-organization-membership-foundation.md); application code
// must resolve it via the stable `slug` (RELAIS_ORGANIZATION_SLUG in
// src/lib/organization.ts), never a hardcoded id, since ids differ per
// environment/database.
model Organization {
  id String @id @default(cuid())

  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
}

// Ticket 26B — the tenant relationship: which User belongs to which
// Organization, and their role within it. `role` reuses the existing
// UserRole enum (no second role concept) and is a transitional SHADOW COPY
// only — User.role remains runtime authorization authority until a later
// explicit ticket switches it (see notes/ticket-26b-organization-membership-foundation.md).
// No membership status (ACTIVE/INVITED/SUSPENDED/REMOVED) yet — mere
// existence of a row is enough for this foundation ticket. `userId` is
// deliberately NOT globally unique: a User is a global identity that may
// structurally belong to multiple Organizations, so uniqueness is scoped to
// the (organization, user) pair below.
model OrganizationMembership {
  id String @id @default(cuid())

  organizationId String
  userId         String

  role UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, not Cascade/SetNull: neither a User nor an Organization has a
  // deletion flow in 26B, and history (dual-write role sync) must never be
  // silently orphaned. Consistent with the existing repo convention of
  // Restrict on every other User historical relation (UserStatusActivity,
  // UserCreationActivity, ProspectAction's four User relations).
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  passwordHash String?

  role UserRole

  active Boolean @default(true)

  // Ticket 19A — the employee's current daily-report template, distinct
  // from `role` (CRM permission). Nullable: not every CRM user submits
  // daily reports. Changing this only affects reports created afterward —
  // DailyReport.templateType snapshots the template at creation time.
  dailyReportTemplateType DailyReportTemplateType?

  // Ticket 26B — a User is a global identity that may structurally belong
  // to multiple Organizations (see the model comment on
  // OrganizationMembership above). Runtime code must not yet depend on
  // this relation for authorization; User.role remains authoritative.
  organizationMemberships OrganizationMembership[]

  // Ticket 27B — two distinct relations for the same reason ProspectAction
  // needs four: the employee whose workday it is, and the actor who later
  // confirmed it, are different roles that both point back at User.
  workdays          Workday[] @relation("EmployeeWorkdays")
  confirmedWorkdays Workday[] @relation("ConfirmedWorkdays")

  assignedProspects    Prospect[]
  personalNotes        PersonalNote[]
  createdLedgerEntries LedgerEntry[]
  dailyReports         DailyReport[]

  statusActivities      UserStatusActivity[] @relation("UserStatusActivityTarget")
  statusActivityActions UserStatusActivity[] @relation("UserStatusActivityActor")

  creationActivity        UserCreationActivity?  @relation("UserCreationActivitySubject")
  creationActivityActions UserCreationActivity[] @relation("UserCreationActivityActor")

  // Ticket 20B — a User may appear in a ProspectAction in up to four
  // distinct roles at once (assignee, creator, completer, canceler); each
  // needs its own named relation since they all point back at User.
  assignedProspectActions  ProspectAction[] @relation("ProspectActionAssignee")
  createdProspectActions   ProspectAction[] @relation("ProspectActionCreator")
  completedProspectActions ProspectAction[] @relation("ProspectActionCompleter")
  canceledProspectActions  ProspectAction[] @relation("ProspectActionCanceler")

  // Ticket 25H.1 — commercial result credit, distinct from ProspectActivity's
  // unrelated (string-only) agentName concept; see the field comment above
  // `model ProspectActivity`.
  creditedProspectActivities ProspectActivity[] @relation("ProspectActivityCreditedUser")

  // Ticket 25H.2A — the comparison basis Results scoring is blocked on
  // (see notes/ticket-25h2-commercial-results-score-engine.md). Two named
  // relations for the same reason ProspectAction needs four: an employee
  // and a target's creator are different roles that both point back at User.
  commercialPerformanceTargets        CommercialPerformanceTarget[] @relation("CommercialPerformanceTargetEmployee")
  createdCommercialPerformanceTargets CommercialPerformanceTarget[] @relation("CommercialPerformanceTargetCreator")

  // Ticket 25I — same two-relation reasoning as above: the assessed
  // employee and the evaluator are different roles, both User.
  roleResponsibilityAssessmentsAsEmployee  RoleResponsibilityAssessment[] @relation("RoleResponsibilityAssessmentEmployee")
  roleResponsibilityAssessmentsAsEvaluator RoleResponsibilityAssessment[] @relation("RoleResponsibilityAssessmentEvaluator")

  // Ticket 25J — same two-relation reasoning as Role Responsibilities.
  professionalContributionAssessmentsAsEmployee  ProfessionalContributionAssessment[] @relation("ProfessionalContributionAssessmentEmployee")
  professionalContributionAssessmentsAsEvaluator ProfessionalContributionAssessment[] @relation("ProfessionalContributionAssessmentEvaluator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([dailyReportTemplateType])
}

// Ticket 18A — the only historical record of User.active transitions.
// The boolean alone is never trustworthy evidence of a past transition, so
// this is written transactionally whenever `active` actually flips.
model UserStatusActivity {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserStatusActivityTarget", fields: [userId], references: [id], onDelete: Restrict)

  type UserStatusActivityType

  actorUserId String
  actorUser   User   @relation("UserStatusActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([actorUserId])
}

// Ticket 25C — one forward-only, durable fact for an authenticated user
// creation. This is deliberately separate from UserStatusActivity: creating
// an employee/account is not an active-status transition. roleAtEvent is a
// snapshot and must never be re-derived from the mutable User.role field.
// Existing users are intentionally not backfilled because their creator and
// creation-time role cannot be reconstructed truthfully.
model UserCreationActivity {
  id String @id @default(cuid())

  subjectUserId String @unique
  subjectUser   User   @relation("UserCreationActivitySubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  actorUserId String
  actorUser   User   @relation("UserCreationActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  roleAtEvent UserRole
  occurredAt  DateTime @default(now())

  @@index([actorUserId])
  @@index([occurredAt])
}

// Ticket 27B — the durable foundation for "Ma journée" (Ticket 27A's
// domain audit is authoritative for every decision below; this model
// encodes only the facts 27A already decided, no more).
//
// Central invariant (27A §2/§7): a Workday row exists IF AND ONLY IF the
// employee has declared that they started that workday. Nothing in this
// schema — and nothing that may read it later — should ever create a row
// merely because a task was assigned, the calendar date arrived, or an
// employee is active/on a roster. Row existence itself is the historical
// evidence of a start declaration; `startedAt` is therefore required, not
// nullable — a Workday with no start declaration must remain structurally
// impossible, not just discouraged by convention.
//
// `expectedStartTime`/`expectedEndTime` are a snapshot (minutes since
// RELAIS business midnight) of the schedule in effect when this row was
// created — not a live read of "today's hours" — so a future change to
// RELAIS's official working hours can never silently reinterpret an old
// Workday's lateness. No Schedule model exists or is implied by these
// two integers.
//
// No status enum: lifecycle state is fully derivable from the timestamp
// tuple (27A §12.1) — NOT STARTED (no row) / STARTED-UNCONFIRMED
// (confirmedAt null, endedAt null) / CONFIRMED (confirmedAt set, endedAt
// null) / ENDED-UNCONFIRMED (endedAt set, confirmedAt null — a valid,
// truthful terminal state, never treated as absence) / ENDED-CONFIRMED
// (both set). No lateness field either — derivable at read time from
// `startedAt` vs. `expectedStartTime`.
//
// `confirmedAt` means "when an authorized actor confirmed this
// employee's presence/start," never "when the employee actually started"
// — it must never be conflated with or substitute for `startedAt` (27A
// §9/§20). No `endConfirmedAt`/`endConfirmedBy`: there is no management
// confirmation lifecycle for ending a workday (27A §14/§30).
//
// No role-at-event snapshot on either User relation (27A §16) — identity
// alone is sufficient provenance here, directly reusing ProspectAction's
// existing zero-role-snapshot precedent: a later role change for the
// employee or the confirming actor never invalidates or reinterprets old
// Workday history. Both User relations are `onDelete: Restrict` for the
// same reason every other historical User relation in this schema is —
// there is no User-deletion path in this codebase today, and Workday
// history must survive deactivation exactly like every other domain's
// history already does.
//
// Deliberately no relation to DailyTask, Prospect/ProspectAction,
// DailyReport, or Organization — see 27A §7 (DailyTask is independently
// keyed by employee+workDate, no FK either direction), §11.14-11.15
// (CRM/report domains are separate facts sharing only a date), and §21
// (Phase 26 stays paused; RELAIS-only for now, no organizationId).
model Workday {
  id String @id @default(cuid())

  employeeUserId String
  employee       User   @relation("EmployeeWorkdays", fields: [employeeUserId], references: [id], onDelete: Restrict)

  // The RELAIS business-calendar date this declaration belongs to — not
  // startedAt, not createdAt. Normalized to business midnight at write
  // time using the existing centralized business-timezone helpers
  // (financial-report-period.ts / daily-report-date.ts), the same way
  // DailyReport.reportDate already is. Normalization is 27C's job; this
  // field is only the durable storage for it.
  workDate DateTime

  // Minutes since RELAIS business midnight — snapshotted at creation,
  // never a live schedule lookup. Current defaults: 480 (08:00), 1020
  // (17:00). Never persist a formatted time string; never introduce a
  // Schedule model for this.
  expectedStartTime Int
  expectedEndTime   Int

  // The timestamp RELAIS CRM accepted the employee's declaration that
  // they were starting their workday — not proof of physical arrival.
  // Required, not nullable: see the model-level invariant comment above.
  // Set once, server-side, at row creation (27C) — never client-supplied,
  // never later rewritten.
  startedAt DateTime

  // A separate management fact from startedAt, never a replacement for
  // it (27A §9/§19-20). Both nullable: an employee may start and end
  // with nobody ever confirming them, which is valid, truthful terminal
  // history, never auto-transformed into absence (27A §13, §25).
  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedBy       User?     @relation("ConfirmedWorkdays", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  // Nullable: the employee may have started but not yet declared the
  // end. Set once, server-side, at end declaration (27C) — never
  // client-supplied, never later rewritten.
  endedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeUserId, workDate])
  @@index([workDate])
  @@index([confirmedByUserId])
}

model PersonalNote {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  category PersonalNoteCategory

  title   String
  content String?

  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, pinned, updatedAt])
  @@index([userId, category])
}

// Ticket 19A — a historical business record: what an employee reported for
// a given Burkina Faso business day. Ownership, date, and template are
// permanent facts about that day and must never be inferred from mutable
// current User state (see User.dailyReportTemplateType comment above).
model DailyReport {
  id String @id @default(cuid())

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  // The Burkina Faso business calendar day this report concerns (see
  // src/lib/daily-report-date.ts) — not createdAt. Normalized to business
  // midnight so @@unique reliably enforces one report per employee per day.
  reportDate DateTime

  // Snapshotted from User.dailyReportTemplateType at creation time. Never
  // re-derived from the User relation, so a later template reassignment
  // does not rewrite historical reports.
  templateType DailyReportTemplateType

  status DailyReportStatus @default(DRAFT)

  accomplishedToday String
  plannedTomorrow   String

  // Ticket 19B — template-specific payload (Assistant vs Operations
  // Coordinator fields), validated against `templateType` server-side
  // before every write (see daily-report-template-data.schema.ts). Never
  // duplicates accomplishedToday/plannedTomorrow. Nullable: pre-19B
  // reports and a brand-new draft may have none yet.
  templateData Json?

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, reportDate])
  @@index([reportDate])
  @@index([ownerUserId, reportDate])
  @@index([status, reportDate])
}

// ── Ticket 20A domain map — read this before touching interest, status,
// nextAction/followUpDate, or ProspectActivity ──────────────────────────
//
// interest         → prospect receptiveness (enum above). Independent axis.
// status           → commercial funnel/pipeline stage (enum above). WON
//                     and LOST are terminal.
// nextAction /
// followUpDate     → the current single-slot "what's next, and when"
//                     follow-up mechanism. Every write overwrites the
//                     previous value with no history kept. Ticket 20B's
//                     ProspectAction will add durable, assignable,
//                     deadline-bearing tasks; until then this pair is the
//                     CRM's only "what's next" signal.
// ProspectActivity → append-only historical events (what actually
//                     happened). WON_TRANSITION is the only durably
//                     recorded status transition today (Ticket 18A).
//                     LOST has no equivalent yet: LOST prospects are
//                     representable, but the moment a prospect became
//                     LOST is not captured anywhere durable. Identified
//                     by the 20A audit, intentionally not built here —
//                     future "time to LOST" / "why we lose" analytics
//                     (20D/20G) cannot be reconstructed for LOST until
//                     that gap is closed.
//
// 20A audited this domain and concluded `status` already serves as the
// funnel field (see the shipped Commercial dashboard pipeline/KPIs) —
// no parallel funnel-stage field was introduced, since that would split
// one business concept into two competing representations.
model Prospect {
  id String @id @default(cuid())

  product RelaisProduct

  name         String
  prospectType String
  contactName  String?
  phone        String
  location     String?

  interest InterestLevel
  status   ProspectStatus @default(NEW)

  // Current, single-slot follow-up mechanism — see the Ticket 20A domain
  // map above `model Prospect`.
  nextAction   FollowUpAction?
  followUpDate DateTime?

  notes String

  onlinePresence OnlinePresence?

  agentName String

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  // KARMDA
  schoolType            String?
  estimatedStudentCount Int?
  currentSchoolSystem   String?
  contactRole           String?

  // LOKARI
  propertyOwnerType      String?
  estimatedPropertyCount Int?
  propertyCountries      String?
  currentPropertySystem  String?

  // NIA
  savingsGroupType      String?
  estimatedMemberCount  Int?
  contributionFrequency String?
  currentSavingsSystem  String?

  // DIGITAL SERVICES
  businessCategory String?
  requestedService String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProspectActivity[]
  actions    ProspectAction[]

  @@index([product])
  @@index([interest])
  @@index([status])
  @@index([agentName])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([followUpDate])
}

model ProspectActivity {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type ProspectActivityType

  summary String
  details String?

  occurredAt DateTime

  agentName String?

  // Ticket 20D — structured commercial outcome/reason for this
  // interaction. Nullable: only the follow-up mini-form's FOLLOW_UP
  // activities populate these going forward; every prior activity (and
  // every future non-FOLLOW_UP type) legitimately has none. No backfill
  // was performed — a null pair means "not recorded", never "neutral" or
  // an inferred value. conversionReasonNote is required by application
  // validation only when conversionReason = OTHER; the column itself
  // stays optional so non-OTHER reasons don't need a redundant note.
  conversionOutcome    ProspectConversionOutcome?
  conversionReason     ProspectConversionReason?
  conversionReasonNote String?

  // Ticket 25H.1 — durable commercial result credit, distinct from
  // `agentName` above: `agentName` is who performed the closing operation
  // (the actor submitting the follow-up); `creditedUserId` is who
  // receives commercial result credit — the prospect's authoritative
  // `assignedUserId` at the moment of the WON transition, never the actor
  // by fallback (see resolveWonCredit in
  // prospect-won-transition.service-core.ts). Populated only for
  // WON_TRANSITION rows, enforced by application logic alone, same
  // pattern as conversionOutcome/conversionReason above — every other
  // activity type legitimately leaves these null. Pre-25H.1 WON_TRANSITION
  // rows are not backfilled: neither `agentName` (proven not equivalent to
  // credit) nor the prospect's current `assignedUserId` (may have changed
  // since the win) is truthful evidence of who was actually credited at
  // that moment, so those rows keep creditedUserId = null — "unknown",
  // never fabricated. creditedUserNameAtEvent/creditedUserRoleAtEvent are
  // frozen snapshots, exactly like UserCreationActivity.roleAtEvent — never
  // re-derived from the User relation on read, so a later name change or
  // role transition cannot rewrite what this event meant when it happened.
  creditedUserId          String?
  creditedUser            User?     @relation("ProspectActivityCreditedUser", fields: [creditedUserId], references: [id], onDelete: Restrict)
  creditedUserNameAtEvent String?
  creditedUserRoleAtEvent UserRole?

  createdAt DateTime @default(now())

  @@index([prospectId])
  @@index([prospectId, occurredAt])
  @@index([type])
  @@index([creditedUserId, occurredAt])
}

// Ticket 20B — durable accountability: "what must happen, who must do
// it, by when." Distinct from ProspectActivity ("what happened") and
// from the legacy Prospect.nextAction/followUpDate pair (mutable,
// single-slot, no history) — see the Ticket 20A domain map above `model
// Prospect`. Coexists with that legacy pair; this ticket does not remove
// or synchronize with it. No hard delete: terminal (COMPLETED/CANCELED)
// actions stay queryable as operational history, hence `onDelete:
// Restrict` on every User relation below. Prospect is never hard-deleted
// today, so `onDelete: Restrict` on `prospect` is likewise a safe,
// future-proofing default rather than a live constraint.
model ProspectAction {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  // Exactly one assignee in V1 — no multi-assignee/team tasks yet. Any
  // active User regardless of role (ADMIN/MANAGER/COMMERCIAL and future
  // roles) may be assigned; see canCompleteProspectAction/
  // canCancelProspectAction in prospect-action.service-core.ts for who
  // may act on it afterward.
  assignedToUserId String
  assignedToUser   User   @relation("ProspectActionAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)

  // Always the authenticated actor who created the action — never
  // client-supplied. See createProspectActionAction.
  createdByUserId String
  createdByUser   User   @relation("ProspectActionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  status ProspectActionStatus @default(OPEN)

  title       String
  description String?

  dueAt DateTime

  // Set atomically together, once, only from OPEN. Terminal actions are
  // immutable in V1 — no reopen, no edit, no changing who completed/
  // canceled it or when.
  completedAt       DateTime?
  completedByUserId String?
  completedByUser   User?     @relation("ProspectActionCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)

  canceledAt         DateTime?
  canceledByUserId   String?
  canceledByUser     User?     @relation("ProspectActionCanceler", fields: [canceledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prospectId, status, dueAt])
  @@index([assignedToUserId, status, dueAt])
  @@index([createdByUserId, createdAt])
}

model LedgerEntry {
  id String @id @default(cuid())

  type     LedgerEntryType
  category LedgerEntryCategory
  status   LedgerEntryStatus   @default(POSTED)

  amount       Decimal @db.Decimal(18, 2)
  currencyCode String  @default("XOF") @db.VarChar(3)

  product RelaisProduct?

  counterpartyName String
  reason           String

  paymentMethod PaymentMethod
  reference     String?

  occurredAt DateTime

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  reversalOfId String?      @unique
  reversalOf   LedgerEntry? @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)

  reversedBy LedgerEntry? @relation("LedgerEntryReversal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([product])
  @@index([occurredAt])
  @@index([createdByUserId])
  @@index([currencyCode, occurredAt])
}

// Ticket 25H.2A — the durable comparison basis 25H.2's Results evidence
// engine needs before creditedWins can become a /40 score. Deliberately
// narrow: COMMERCIAL-only, one metric (targetWins), one target per
// employee per canonical calendar month.
//
// Historical stability, mirroring UserCreationActivity.roleAtEvent and
// ProspectActivity.creditedUserRoleAtEvent: roleAtAssignment and
// createdByRoleAtEvent are frozen snapshots, never re-derived from the
// live User relation. A COMMERCIAL's August target stays an August
// Commercial target even after a September promotion to MANAGER.
//
// Freeze-before-period semantics (Option A, no revision history — see
// the notes doc): editable/deletable only while `now < periodStart`,
// enforced entirely in application logic (createCommercialPerformanceTargetCore
// / updateCommercialPerformanceTargetCore / deleteCommercialPerformanceTargetCore),
// not by any DB constraint, since "now" isn't a schema-expressible
// condition. No separate lifecycle/status column: lock state is always
// derived from periodStart vs. the current instant, never persisted.
model CommercialPerformanceTarget {
  id String @id @default(cuid())

  userId String
  user   User   @relation("CommercialPerformanceTargetEmployee", fields: [userId], references: [id], onDelete: Restrict)

  // Both inclusive, always the canonical business-timezone calendar-month
  // boundary computed by resolveCommercialPerformanceTargetMonth — never
  // an arbitrary caller-supplied range, so the uniqueness constraint below
  // reliably means "one target per employee per month".
  periodStart DateTime
  periodEnd   DateTime

  targetWins Int

  // Snapshot at creation — see the model comment above. Not the eligibility
  // check for whether a target is *creatable* (that's enforced at write
  // time by createCommercialPerformanceTargetCore); this is what the
  // target meant once it existed.
  roleAtAssignment UserRole

  createdByUserId      String
  createdByUser        User     @relation("CommercialPerformanceTargetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByRoleAtEvent UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, periodStart])
  @@index([createdByUserId])
}

// Ticket 25I — the Role Responsibilities /20 dimension. One row per
// employee per evaluation period (@@unique below), status DRAFT ->
// SUBMITTED, immutable once submitted — no in-place correction lifecycle
// in V1 (§26: a future void/supersede model, not built here). `score`
// stays null until submission; `maxScore` is stored per-row rather than
// assumed as a global constant so a future per-role max wouldn't require
// a migration to represent historically.
//
// `roleAtEvaluation` is a snapshot of the employee's role AT ASSESSMENT
// CREATION TIME, not a verified guarantee that they held that role for
// the entire period — this CRM has no durable role-change-history model
// (confirmed: User.role has no dated transition log), so a
// ROLE_CHANGED_DURING_PERIOD safeguard cannot be built truthfully today.
// Documented as a known limitation, not implemented as a fake check.
model RoleResponsibilityAssessment {
  id String @id @default(cuid())

  employeeUserId String
  employee       User   @relation("RoleResponsibilityAssessmentEmployee", fields: [employeeUserId], references: [id], onDelete: Restrict)

  roleAtEvaluation UserRole

  periodStart DateTime
  periodEnd   DateTime

  policyVersion String

  evaluatorUserId      String
  evaluator            User     @relation("RoleResponsibilityAssessmentEvaluator", fields: [evaluatorUserId], references: [id], onDelete: Restrict)
  evaluatorRoleAtEvent UserRole

  status RoleResponsibilityAssessmentStatus @default(DRAFT)

  score    Int?
  maxScore Int  @default(20)

  submittedAt DateTime?

  items RoleResponsibilityAssessmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeUserId, periodStart, periodEnd])
  @@index([employeeUserId, periodStart])
  @@index([evaluatorUserId])
  @@index([status])
}

// Ticket 25I §24 — a full snapshot of the catalog definition
// (src/lib/role-responsibility-catalog.ts) at the moment the parent
// assessment was created, including `anchorsSnapshot` (all four levels'
// text and point values). A future catalog edit — a relabeled
// responsibility, a rewritten anchor, a changed point mapping — never
// rewrites what an evaluator was actually shown, exactly like
// ProspectActivity.creditedUserRoleAtEvent's "never re-derived" rule.
// `awardedPoints` is computed from THIS row's own anchorsSnapshot at the
// moment `assessmentLevel` is set, never re-derived from the live
// catalog — see role-responsibility-assessment.service-core.ts.
model RoleResponsibilityAssessmentItem {
  id String @id @default(cuid())

  assessmentId String
  assessment   RoleResponsibilityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  responsibilityKey       String
  labelAtEvaluation       String
  descriptionAtEvaluation String
  maxPoints               Int
  evidenceType            RoleResponsibilityEvidenceType
  anchorsSnapshot         Json

  // Null = UNASSESSED (Ticket 25I §15) — distinct from N/A, which V1
  // does not implement (see the service-core file's own comment on why:
  // the audited catalog has exactly one responsibility per supported
  // role, so there is no partial-applicability scenario to normalize).
  // Submission requires every item to have a non-null assessmentLevel.
  assessmentLevel RoleResponsibilityAssessmentLevel?
  awardedPoints   Int?
  observation     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, responsibilityKey])
  @@index([assessmentId])
}

// Ticket 25J — the fourth and final performance dimension, /10. A
// deliberately separate model from RoleResponsibilityAssessment (§28 of
// the ticket: distinct catalogs, distinct meaning — job duties vs.
// cross-role professional behavior), sharing only the lifecycle shape
// (DRAFT -> SUBMITTED, immutable once submitted, one row per employee
// per exact period) and the evaluator-authorization rule (see
// src/lib/employee-assessment-authorization.ts, reused because it is
// genuinely identical, not because the two domains are coupled).
//
// roleAtEvaluation/evaluatorRoleAtEvent carry the same honest limitation
// as RoleResponsibilityAssessment: a snapshot of the *current* role at
// assessment-creation time, not a verified guarantee the employee held
// that role for the entire period — this CRM has no dated role-change
// history to check against.
model ProfessionalContributionAssessment {
  id String @id @default(cuid())

  employeeUserId String
  employee       User   @relation("ProfessionalContributionAssessmentEmployee", fields: [employeeUserId], references: [id], onDelete: Restrict)

  roleAtEvaluation UserRole

  periodStart DateTime
  periodEnd   DateTime

  policyVersion String

  evaluatorUserId      String
  evaluator            User     @relation("ProfessionalContributionAssessmentEvaluator", fields: [evaluatorUserId], references: [id], onDelete: Restrict)
  evaluatorRoleAtEvent UserRole

  status ProfessionalContributionAssessmentStatus @default(DRAFT)

  score    Int?
  maxScore Int  @default(10)

  submittedAt DateTime?

  items ProfessionalContributionAssessmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeUserId, periodStart, periodEnd])
  @@index([employeeUserId, periodStart])
  @@index([evaluatorUserId])
  @@index([status])
}

// Ticket 25J §30/§31 — the full trait definition, including all five
// anchors' text, is frozen at assessment-creation time in
// anchorsSnapshot. `awardedPoints` is a Float, not an Int like 25I's
// item: the point mapping is a proportional formula
// (maxPoints * (level - 1) / 4), not a fixed per-level table, so a
// 3-point trait's intermediate levels are genuinely fractional (e.g.
// 2.25) — only the *final* assessment-level score is rounded to an
// integer, once, at submission (see
// professional-contribution.service-core.ts's computeProfessionalContributionScore).
model ProfessionalContributionAssessmentItem {
  id String @id @default(cuid())

  assessmentId String
  assessment   ProfessionalContributionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  traitKey                String
  labelAtEvaluation       String
  descriptionAtEvaluation String
  maxPoints               Int
  anchorsSnapshot         Json

  // Null = UNASSESSED. 1-5 once assessed; validated in application logic
  // (no DB-level range check, matching this schema's existing convention
  // of enforcing numeric ranges in the domain core, not via CHECK
  // constraints).
  selectedLevel Int?
  awardedPoints Float?
  observation   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, traitKey])
  @@index([assessmentId])
}
