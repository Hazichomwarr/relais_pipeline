// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RelaisProduct {
  KARMDA
  LOKARI
  NIA
  DIGITAL_SERVICES
}

// Ticket 20A — prospect receptiveness: "how open is this prospect to
// RELAIS," independent of commercial progression. Set at creation and on
// every follow-up/interaction update; never derived from `status`, and
// `status` is never derived from it. See the domain map above `model
// Prospect` for the full picture.
enum InterestLevel {
  NOT_INTERESTED
  MAYBE
  NEEDS_INFORMATION
  INTERESTED
  READY_TO_DISCUSS
}

enum FollowUpAction {
  CALL_BACK
  VISIT_AGAIN
  SEND_DEMO
  SCHEDULE_MEETING
  NO_ACTION
}

// Ticket 20A — the CRM's one commercial funnel/pipeline field ("where is
// this opportunity in the process"), already relied on as such by the
// Commercial dashboard's "Pipeline personnel" and its KPIs (qualified/
// won/lost counts, conversion rate). NEW → CONTACTED → QUALIFIED →
// PROPOSAL_SENT → WON/LOST is the intended forward progression; WON and
// LOST are terminal. No transition between values is enforced — any
// value may follow any other, including backward moves, because real
// sales conversations don't always move forward.
//
// TO_FOLLOW_UP is the one non-sequential exception: an operational
// "prioritize this in the queue" flag (see isFollowUpQueueCandidate),
// not a stage of commercial progress. Setting it overwrites whatever
// stage the prospect was actually at, which is a known, accepted
// limitation of the single-field design, not a stage that sits between
// NEW and CONTACTED. Do not reinterpret it as one.
//
// This is intentionally the CRM's only funnel-stage concept — do not add
// a parallel `stage` / `pipelineStage` / `commercialStage` field. See the
// domain map above `model Prospect`.
enum ProspectStatus {
  NEW
  TO_FOLLOW_UP
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum OnlinePresence {
  NONE
  WHATSAPP
  SOCIAL_MEDIA
  WEBSITE
  MULTIPLE
}

enum ProspectActivityType {
  FIELD_VISIT
  PHONE_CALL
  WHATSAPP
  MEETING
  DEMO
  DOCUMENT_SENT
  FOLLOW_UP
  INTERNAL_NOTE
  // System-generated only (Ticket 18A) — never user-selectable. Written in
  // the same transaction as the status mutation that causes the WON
  // transition, so À la une can source a reliable "prospect won" event
  // without fabricating history from Prospect.status alone.
  WON_TRANSITION
}

enum UserStatusActivityType {
  ACTIVATED
  DEACTIVATED
}

enum UserRole {
  ADMIN
  COMMERCIAL
  MANAGER
}

enum PersonalNoteCategory {
  URGENT_TODO
  COMMERCIAL_DEBRIEF
  RELAIS_IDEA
  SCHOOL_DOCUMENTS
  OTHER
}

enum LedgerEntryType {
  INFLOW
  OUTFLOW
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHECK
  OTHER
}

enum DailyReportTemplateType {
  ASSISTANT
  OPERATIONS_COORDINATOR
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum LedgerEntryCategory {
  CLIENT_PAYMENT
  CAPITAL_CONTRIBUTION
  LOAN_RECEIVED
  REFUND_RECEIVED
  OTHER_INFLOW

  SALARY
  TRANSPORT
  FUEL
  PRINTING
  INTERNET
  OFFICE_SUPPLIES
  EQUIPMENT
  TAXES_AND_FEES
  CLIENT_REFUND
  OTHER_OUTFLOW
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  passwordHash String?

  role UserRole

  active Boolean @default(true)

  // Ticket 19A — the employee's current daily-report template, distinct
  // from `role` (CRM permission). Nullable: not every CRM user submits
  // daily reports. Changing this only affects reports created afterward —
  // DailyReport.templateType snapshots the template at creation time.
  dailyReportTemplateType DailyReportTemplateType?

  assignedProspects    Prospect[]
  personalNotes        PersonalNote[]
  createdLedgerEntries LedgerEntry[]
  dailyReports         DailyReport[]

  statusActivities      UserStatusActivity[] @relation("UserStatusActivityTarget")
  statusActivityActions UserStatusActivity[] @relation("UserStatusActivityActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([dailyReportTemplateType])
}

// Ticket 18A — the only historical record of User.active transitions.
// The boolean alone is never trustworthy evidence of a past transition, so
// this is written transactionally whenever `active` actually flips.
model UserStatusActivity {
  id String @id @default(cuid())

  userId String
  user   User @relation("UserStatusActivityTarget", fields: [userId], references: [id], onDelete: Restrict)

  type UserStatusActivityType

  actorUserId String
  actorUser   User @relation("UserStatusActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([actorUserId])
}

model PersonalNote {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  category PersonalNoteCategory

  title   String
  content String?

  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, pinned, updatedAt])
  @@index([userId, category])
}

// Ticket 19A — a historical business record: what an employee reported for
// a given Burkina Faso business day. Ownership, date, and template are
// permanent facts about that day and must never be inferred from mutable
// current User state (see User.dailyReportTemplateType comment above).
model DailyReport {
  id String @id @default(cuid())

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  // The Burkina Faso business calendar day this report concerns (see
  // src/lib/daily-report-date.ts) — not createdAt. Normalized to business
  // midnight so @@unique reliably enforces one report per employee per day.
  reportDate DateTime

  // Snapshotted from User.dailyReportTemplateType at creation time. Never
  // re-derived from the User relation, so a later template reassignment
  // does not rewrite historical reports.
  templateType DailyReportTemplateType

  status DailyReportStatus @default(DRAFT)

  accomplishedToday String
  plannedTomorrow   String

  // Ticket 19B — template-specific payload (Assistant vs Operations
  // Coordinator fields), validated against `templateType` server-side
  // before every write (see daily-report-template-data.schema.ts). Never
  // duplicates accomplishedToday/plannedTomorrow. Nullable: pre-19B
  // reports and a brand-new draft may have none yet.
  templateData Json?

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, reportDate])
  @@index([reportDate])
  @@index([ownerUserId, reportDate])
  @@index([status, reportDate])
}

// ── Ticket 20A domain map — read this before touching interest, status,
// nextAction/followUpDate, or ProspectActivity ──────────────────────────
//
// interest         → prospect receptiveness (enum above). Independent axis.
// status           → commercial funnel/pipeline stage (enum above). WON
//                     and LOST are terminal.
// nextAction /
// followUpDate     → the current single-slot "what's next, and when"
//                     follow-up mechanism. Every write overwrites the
//                     previous value with no history kept. Ticket 20B's
//                     ProspectAction will add durable, assignable,
//                     deadline-bearing tasks; until then this pair is the
//                     CRM's only "what's next" signal.
// ProspectActivity → append-only historical events (what actually
//                     happened). WON_TRANSITION is the only durably
//                     recorded status transition today (Ticket 18A).
//                     LOST has no equivalent yet: LOST prospects are
//                     representable, but the moment a prospect became
//                     LOST is not captured anywhere durable. Identified
//                     by the 20A audit, intentionally not built here —
//                     future "time to LOST" / "why we lose" analytics
//                     (20D/20G) cannot be reconstructed for LOST until
//                     that gap is closed.
//
// 20A audited this domain and concluded `status` already serves as the
// funnel field (see the shipped Commercial dashboard pipeline/KPIs) —
// no parallel funnel-stage field was introduced, since that would split
// one business concept into two competing representations.
model Prospect {
  id String @id @default(cuid())

  product RelaisProduct

  name         String
  prospectType String
  contactName  String?
  phone        String
  location     String?

  interest InterestLevel
  status   ProspectStatus @default(NEW)

  // Current, single-slot follow-up mechanism — see the Ticket 20A domain
  // map above `model Prospect`.
  nextAction   FollowUpAction?
  followUpDate DateTime?

  notes String

  onlinePresence OnlinePresence?

  agentName String

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  // KARMDA
  schoolType            String?
  estimatedStudentCount Int?
  currentSchoolSystem   String?
  contactRole           String?

  // LOKARI
  propertyOwnerType      String?
  estimatedPropertyCount Int?
  propertyCountries      String?
  currentPropertySystem  String?

  // NIA
  savingsGroupType      String?
  estimatedMemberCount  Int?
  contributionFrequency String?
  currentSavingsSystem  String?

  // DIGITAL SERVICES
  businessCategory String?
  requestedService String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProspectActivity[]

  @@index([product])
  @@index([interest])
  @@index([status])
  @@index([agentName])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([followUpDate])
}

model ProspectActivity {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type ProspectActivityType

  summary String
  details String?

  occurredAt DateTime

  agentName String?

  createdAt DateTime @default(now())

  @@index([prospectId])
  @@index([prospectId, occurredAt])
  @@index([type])
}

model LedgerEntry {
  id String @id @default(cuid())

  type     LedgerEntryType
  category LedgerEntryCategory
  status   LedgerEntryStatus   @default(POSTED)

  amount       Decimal @db.Decimal(18, 2)
  currencyCode String  @default("XOF") @db.VarChar(3)

  product RelaisProduct?

  counterpartyName String
  reason           String

  paymentMethod PaymentMethod
  reference     String?

  occurredAt DateTime

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  reversalOfId String?      @unique
  reversalOf   LedgerEntry? @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)

  reversedBy LedgerEntry? @relation("LedgerEntryReversal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([product])
  @@index([occurredAt])
  @@index([createdByUserId])
  @@index([currencyCode, occurredAt])
}
