// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RelaisProduct {
  KARMDA
  LOKARI
  NIA
  DIGITAL_SERVICES
}

enum InterestLevel {
  NOT_INTERESTED
  MAYBE
  NEEDS_INFORMATION
  INTERESTED
  READY_TO_DISCUSS
}

enum FollowUpAction {
  CALL_BACK
  VISIT_AGAIN
  SEND_DEMO
  SCHEDULE_MEETING
  NO_ACTION
}

enum ProspectStatus {
  NEW
  TO_FOLLOW_UP
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum OnlinePresence {
  NONE
  WHATSAPP
  SOCIAL_MEDIA
  WEBSITE
  MULTIPLE
}

enum ProspectActivityType {
  FIELD_VISIT
  PHONE_CALL
  WHATSAPP
  MEETING
  DEMO
  DOCUMENT_SENT
  FOLLOW_UP
  INTERNAL_NOTE
}

enum UserRole {
  ADMIN
  COMMERCIAL
  MANAGER
}

enum PersonalNoteCategory {
  URGENT_TODO
  COMMERCIAL_DEBRIEF
  RELAIS_IDEA
  SCHOOL_DOCUMENTS
  OTHER
}

enum LedgerEntryType {
  INFLOW
  OUTFLOW
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHECK
  OTHER
}

enum LedgerEntryCategory {
  CLIENT_PAYMENT
  CAPITAL_CONTRIBUTION
  LOAN_RECEIVED
  REFUND_RECEIVED
  OTHER_INFLOW

  SALARY
  TRANSPORT
  FUEL
  PRINTING
  INTERNET
  OFFICE_SUPPLIES
  EQUIPMENT
  TAXES_AND_FEES
  CLIENT_REFUND
  OTHER_OUTFLOW
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String?
  phone String?

  passwordHash String?

  role UserRole

  active Boolean @default(true)

  assignedProspects    Prospect[]
  personalNotes        PersonalNote[]
  createdLedgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model PersonalNote {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  category PersonalNoteCategory

  title   String
  content String?

  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, pinned, updatedAt])
  @@index([userId, category])
}

model Prospect {
  id String @id @default(cuid())

  product RelaisProduct

  name         String
  prospectType String
  contactName  String?
  phone        String
  location     String?

  interest InterestLevel
  status   ProspectStatus @default(NEW)

  nextAction   FollowUpAction?
  followUpDate DateTime?

  notes String

  onlinePresence OnlinePresence?

  agentName String

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  // KARMDA
  schoolType            String?
  estimatedStudentCount Int?
  currentSchoolSystem   String?
  contactRole           String?

  // LOKARI
  propertyOwnerType      String?
  estimatedPropertyCount Int?
  propertyCountries      String?
  currentPropertySystem  String?

  // NIA
  savingsGroupType      String?
  estimatedMemberCount  Int?
  contributionFrequency String?
  currentSavingsSystem  String?

  // DIGITAL SERVICES
  businessCategory String?
  requestedService String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProspectActivity[]

  @@index([product])
  @@index([interest])
  @@index([status])
  @@index([agentName])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([followUpDate])
}

model ProspectActivity {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type ProspectActivityType

  summary String
  details String?

  occurredAt DateTime

  agentName String?

  createdAt DateTime @default(now())

  @@index([prospectId])
  @@index([prospectId, occurredAt])
  @@index([type])
}

model LedgerEntry {
  id String @id @default(cuid())

  type     LedgerEntryType
  category LedgerEntryCategory
  status   LedgerEntryStatus   @default(POSTED)

  amount       Decimal @db.Decimal(18, 2)
  currencyCode String  @default("XOF") @db.VarChar(3)

  product RelaisProduct?

  counterpartyName String
  reason           String

  paymentMethod PaymentMethod
  reference     String?

  occurredAt DateTime

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  reversalOfId String?      @unique
  reversalOf   LedgerEntry? @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)

  reversedBy LedgerEntry? @relation("LedgerEntryReversal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([product])
  @@index([occurredAt])
  @@index([createdByUserId])
  @@index([currencyCode, occurredAt])
}
